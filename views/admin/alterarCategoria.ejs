<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Alterar Categoria - Corte Imperial Admin</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
    />
    <link rel="stylesheet" href="/style/admin.css" />
    <script src="/js/cadastrarCategoria.js"></script>
  </head>

  <body>
    <!-- HEADER -->
    <header class="admin-header">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-md-6">
            <div class="d-flex align-items-center">
              <a href="/admin">
                <img
                  src="/imgs/logo.png"
                  alt="Corte Imperial"
                  class="admin-logo me-3"
                />
              </a>

              <div>
                <h1 class="admin-brand">Corte Imperial</h1>
                <p class="admin-subtitle">Painel Administrativo</p>
              </div>
            </div>
          </div>

          <div class="col-md-6 text-end">
            <span class="user-info">
              <i class="bi bi-person-circle"></i>
              Administrador
            </span>

            <button class="btn-logout">
              <i class="bi bi-box-arrow-right"></i>
              Sair
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- TÍTULO -->
    <div class="page-title-section">
      <div class="container">
        <h2 class="page-title">Alterar Categoria</h2>

        <p class="page-breadcrumb">
          <a href="/admin">
            <i class="bi bi-house-door"></i>
            Início
          </a>

          <i class="bi bi-chevron-right"></i>

          <a href="/admin/produto/gerenciamento-categoria"> Categorias </a>

          <i class="bi bi-chevron-right"></i>
          Alterar Categoria
        </p>
      </div>
    </div>

    <!-- ID DA CATEGORIA -->
    <input type="hidden" id="idCat" value="<%= categoria.COD_CAT %>" />

    <!-- CONTEÚDO -->
    <div class="container">
      <div class="editar-cliente-card">
        <!-- CABEÇALHO -->
        <div class="editar-cliente-header">
          <div>
            <h3>
              <i class="bi bi-pencil-square"></i>
              Alterar Categoria
            </h3>

            <p>Atualize as informações cadastrais da categoria.</p>
          </div>

          <a
            href="/admin/produto/gerenciamento-categoria"
            class="btn-voltar-clientes"
          >
            <i class="bi bi-arrow-left"></i>
            Voltar
          </a>
        </div>

        <!-- TOGGLE -->
        <div class="editar-toggle">
          <button type="button" class="toggle-opcao ativo" id="btnDados">
            <i class="bi bi-tags"></i>
            Dados da Categoria
          </button>
        </div>

        <form id="formCategoria">
          <!-- DADOS DA CATEGORIA -->
          <div class="secao-edicao secao-ativa" id="secaoDados">
            <div class="secao-titulo">
              <h4>Dados da Categoria</h4>
              <p>Altere as informações da categoria.</p>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="nomeCat" class="form-label">
                  <i class="bi bi-tag"></i>
                  Nome da Categoria *
                </label>

                <input
                  type="text"
                  class="form-control"
                  id="nomeCat"
                  placeholder="Digite o nome da categoria"
                  value="<%= categoria.NOME_CAT %>"
                />
              </div>
            </div>
          </div>

          <!-- BOTÕES -->
          <div class="editar-footer">
            <a
              href="/admin/produto/gerenciamento-categoria"
              class="btn-cancelar-edicao"
            >
              <i class="bi bi-x-circle"></i>
              Cancelar
            </a>

            <button
              type="button"
              class="btn-salvar-edicao"
              id="btnSalvarAlteracao"
            >
              <i class="bi bi-check-circle"></i>
              Salvar Alterações
            </button>
          </div>
        </form>
      </div>
    </div>

    <div style="height: 50px"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>