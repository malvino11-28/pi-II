<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Alterar Cliente - Corte Imperial Admin</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
    >

    <link rel="stylesheet" href="/style/admin.css">

</head>

<body>


    <!-- HEADER -->
    <header class="admin-header">

        <div class="container">

            <div class="row align-items-center">

                <div class="col-md-6">

                    <div class="d-flex align-items-center">

                        <a href="/admin">

                            <img
                                src="/imgs/logo.png"
                                alt="Corte Imperial"
                                class="admin-logo me-3"
                            >

                        </a>

                        <div>

                            <h1 class="admin-brand">
                                Corte Imperial
                            </h1>

                            <p class="admin-subtitle">
                                Painel Administrativo
                            </p>

                        </div>

                    </div>

                </div>


                <div class="col-md-6 text-end">

                    <span class="user-info">

                        <i class="bi bi-person-circle"></i>

                        Administrador

                    </span>

                    <button class="btn-logout">

                        <i class="bi bi-box-arrow-right"></i>

                        Sair

                    </button>

                </div>

            </div>

        </div>

    </header>



    <!-- TÍTULO -->
    <div class="page-title-section">

        <div class="container">

            <h2 class="page-title">
                Alterar Cliente
            </h2>

            <p class="page-breadcrumb">

                <a href="/admin">

                    <i class="bi bi-house-door"></i>

                    Início

                </a>

                <i class="bi bi-chevron-right"></i>

                <a href="/admin/cadastrar-clientes">
                    Clientes
                </a>

                <i class="bi bi-chevron-right"></i>

                Alterar Cliente

            </p>

        </div>

    </div>



    <!-- CONTEÚDO -->
    <div class="container">

        <div class="editar-cliente-card">


            <!-- CABEÇALHO -->
            <div class="editar-cliente-header">

                <div>

                    <h3>

                        <i class="bi bi-pencil-square"></i>

                        Alterar Cliente

                    </h3>

                    <p>
                        Atualize as informações cadastrais do cliente.
                    </p>

                </div>


                <a
                    href="/admin/cadastrar-clientes"
                    class="btn-voltar-clientes"
                >

                    <i class="bi bi-arrow-left"></i>

                    Voltar

                </a>

            </div>



            <!-- TOGGLE -->
            <div class="editar-toggle">

                <button
                    type="button"
                    class="toggle-opcao ativo"
                    id="btnDados"
                >

                    <i class="bi bi-person-lines-fill"></i>

                    Dados Cadastrais

                </button>


                <button
                    type="button"
                    class="toggle-opcao"
                    id="btnSenha"
                >

                    <i class="bi bi-shield-lock"></i>

                    Senha e Segurança

                </button>

            </div>



            <form id="formAlterarCliente">


                <!-- =====================================
                     DADOS CADASTRAIS
                ====================================== -->

                <div
                    class="secao-edicao secao-ativa"
                    id="secaoDados"
                >


                    <div class="secao-titulo">

                        <h4>
                            Dados Cadastrais
                        </h4>

                        <p>
                            Altere as informações pessoais e de contato do cliente.
                        </p>

                    </div>



                    <!-- LINHA 1 -->
                    <div class="row">


                        <div class="col-md-6 mb-3">

                            <label
                                for="nomeCli"
                                class="form-label"
                            >

                                <i class="bi bi-person"></i>

                                Nome Completo *

                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="nomeCli"
                                placeholder="Digite o nome completo"
                            >

                        </div>



                        <div class="col-md-6 mb-3">

                            <label
                                for="emailCli"
                                class="form-label"
                            >

                                <i class="bi bi-envelope"></i>

                                E-mail *

                            </label>

                            <input
                                type="email"
                                class="form-control"
                                id="emailCli"
                                placeholder="exemplo@email.com"
                            >

                        </div>

                    </div>



                    <!-- LINHA 2 -->
                    <div class="row">


                        <div class="col-md-4 mb-3">

                            <label
                                for="cpfCli"
                                class="form-label"
                            >

                                <i class="bi bi-card-text"></i>

                                CPF *

                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="cpfCli"
                                placeholder="000.000.000-00"
                                maxlength="14"
                            >

                        </div>



                        <div class="col-md-4 mb-3">

                            <label
                                for="rgCli"
                                class="form-label"
                            >

                                <i class="bi bi-person-vcard"></i>

                                RG *

                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="rgCli"
                                placeholder="00.000.000-0"
                            >

                        </div>



                        <div class="col-md-4 mb-3">

                            <label
                                for="dataNascCli"
                                class="form-label"
                            >

                                <i class="bi bi-calendar"></i>

                                Data de Nascimento *

                            </label>

                            <input
                                type="date"
                                class="form-control"
                                id="dataNascCli"
                            >

                        </div>

                    </div>



                    <!-- LINHA 3 -->
                    <div class="row">


                        <div class="col-md-6 mb-3">

                            <label
                                for="celCli"
                                class="form-label"
                            >

                                <i class="bi bi-telephone"></i>

                                Celular *

                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="celCli"
                                placeholder="(00) 00000-0000"
                                maxlength="15"
                            >

                        </div>



                        <div class="col-md-6 mb-3">

                            <label
                                for="statusPlano"
                                class="form-label"
                            >

                                <i class="bi bi-person-check"></i>

                                Status do Plano

                            </label>

                            <input
                                type="text"
                                class="form-control campo-bloqueado"
                                id="statusPlano"
                                placeholder="Status atual do plano"
                                disabled
                            >

                        </div>

                    </div>


                </div>



                <!-- =====================================
                     SENHA
                ====================================== -->

                <div
                    class="secao-edicao"
                    id="secaoSenha"
                >


                    <div class="secao-titulo">

                        <h4>
                            Senha e Segurança
                        </h4>

                        <p>
                            Altere a senha de acesso do cliente somente quando necessário.
                        </p>

                    </div>



                    <div class="aviso-senha">

                        <i class="bi bi-info-circle"></i>

                        <div>

                            <strong>Alteração opcional</strong>

                            <p>
                                Caso não queira alterar a senha, deixe os campos abaixo em branco.
                            </p>

                        </div>

                    </div>



                    <div class="row">


                        <div class="col-md-6 mb-3">

                            <label
                                for="senhaCli"
                                class="form-label"
                            >

                                <i class="bi bi-lock"></i>

                                Nova Senha

                            </label>

                            <input
                                type="password"
                                class="form-control"
                                id="senhaCli"
                                placeholder="Digite uma nova senha"
                            >

                        </div>



                        <div class="col-md-6 mb-3">

                            <label
                                for="confirmarSenhaCli"
                                class="form-label"
                            >

                                <i class="bi bi-lock-fill"></i>

                                Confirmar Nova Senha

                            </label>

                            <input
                                type="password"
                                class="form-control"
                                id="confirmarSenhaCli"
                                placeholder="Digite novamente a nova senha"
                            >

                        </div>

                    </div>


                </div>



                <!-- BOTÕES -->
                <div class="editar-footer">

                    <a
                        href="/admin/cadastrar-clientes"
                        class="btn-cancelar-edicao"
                    >

                        <i class="bi bi-x-circle"></i>

                        Cancelar

                    </a>


                    <button
                        type="button"
                        class="btn-salvar-edicao"
                        id="btnSalvarAlteracao"
                    >

                        <i class="bi bi-check-circle"></i>

                        Salvar Alterações

                    </button>

                </div>


            </form>

        </div>

    </div>



    <div style="height: 50px;"></div>



    <!-- BOOTSTRAP -->
    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    ></script>



    <!-- TOGGLE -->
    <script>

        const btnDados = document.querySelector("#btnDados");
        const btnSenha = document.querySelector("#btnSenha");

        const secaoDados = document.querySelector("#secaoDados");
        const secaoSenha = document.querySelector("#secaoSenha");


        btnDados.addEventListener("click", function () {

            btnDados.classList.add("ativo");
            btnSenha.classList.remove("ativo");

            secaoDados.classList.add("secao-ativa");
            secaoSenha.classList.remove("secao-ativa");

        });


        btnSenha.addEventListener("click", function () {

            btnSenha.classList.add("ativo");
            btnDados.classList.remove("ativo");

            secaoSenha.classList.add("secao-ativa");
            secaoDados.classList.remove("secao-ativa");

        });

    </script>


</body>

</html>