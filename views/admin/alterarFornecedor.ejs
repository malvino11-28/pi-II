<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alterar Fornecedor - Corte Imperial Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/style/admin.css">
    <script src="/js/alterarFornecedor.js"></script>
</head>

<body>

    <header class="admin-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="d-flex align-items-center">
                        <a href="/admin"><img src="/imgs/logo.png" alt="Corte Imperial" class="admin-logo me-3"></a>
                        <div>
                            <h1 class="admin-brand">Corte Imperial</h1>
                            <p class="admin-subtitle">Painel Administrativo</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 text-end">
                    <span class="user-info"><i class="bi bi-person-circle"></i> Administrador</span>
                    <button class="btn-logout"><i class="bi bi-box-arrow-right"></i> Sair</button>
                </div>
            </div>
        </div>
    </header>

    <div class="page-title-section">
        <div class="container">
            <h2 class="page-title">Alterar Fornecedor</h2>

            <p class="page-breadcrumb">
                <a href="/admin"><i class="bi bi-house-door"></i> Início</a>
                <i class="bi bi-chevron-right"></i>
                <a href="/admin/cadastrar-fornecedores">Fornecedores</a>
                <i class="bi bi-chevron-right"></i>
                Alterar Fornecedor
            </p>
        </div>
    </div>

    <div class="container">

        <div class="editar-cliente-card">

            <div class="editar-cliente-header">
                <div>
                    <h3><i class="bi bi-building-gear"></i> Alterar Fornecedor</h3>
                    <p>Atualize as informações cadastrais do fornecedor.</p>
                </div>

                <a href="/admin/cadastrar-fornecedores" class="btn-voltar-clientes">
                    <i class="bi bi-arrow-left"></i> Voltar
                </a>
            </div>

            <form id="formAlterarFornecedor">

                <div class="secao-edicao secao-ativa">

                    <div class="secao-titulo">
                        <h4>Dados do Fornecedor</h4>
                        <p>Altere os dados empresariais e as informações de contato.</p>
                    </div>

                    <div class="row">

                        <input id="inputId" type="hidden" value="<%= forAlter.id %>">

                        <div class="col-md-6 mb-3">
                            <label for="razaoFornecedor" class="form-label">
                                <i class="bi bi-building"></i> Razão Social *
                            </label>

                            <input type="text" class="form-control" id="razaoFornecedor" placeholder="Digite a razão social">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="nomeFantasiaFornecedor" class="form-label">
                                <i class="bi bi-shop"></i> Nome Fantasia
                            </label>

                            <input type="text" class="form-control" id="nomeFantasiaFornecedor" placeholder="Digite o nome fantasia">
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-4 mb-3">
                            <label for="cnpjFornecedor" class="form-label">
                                <i class="bi bi-card-text"></i> CNPJ *
                            </label>

                            <input type="text" class="form-control" id="cnpjFornecedor" placeholder="00.000.000/0000-00" maxlength="18">
                        </div>

                        <div class="col-md-4 mb-3">
                            <label for="telefoneFornecedor" class="form-label">
                                <i class="bi bi-telephone"></i> Telefone *
                            </label>

                            <input type="text" class="form-control" id="telefoneFornecedor" placeholder="(00) 00000-0000" maxlength="15">
                        </div>

                        <div class="col-md-4 mb-3">
                            <label for="emailFornecedor" class="form-label">
                                <i class="bi bi-envelope"></i> E-mail *
                            </label>

                            <input type="email" class="form-control" id="emailFornecedor" placeholder="fornecedor@email.com">
                        </div>

                    </div>

                </div>

                <div class="editar-footer">
                    <a href="/admin/cadastrar-fornecedores" class="btn-cancelar-edicao">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </a>

                    <button type="button" class="btn-salvar-edicao" id="btnSalvarAlteracaoFornecedor">
                        <i class="bi bi-check-circle"></i> Salvar Alterações
                    </button>
                </div>

            </form>

        </div>

    </div>

    <div style="height: 50px;"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>