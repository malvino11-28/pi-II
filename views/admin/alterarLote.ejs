<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0">
  <title>
    Alterar Lote - Corte Imperial Admin
  </title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    rel="stylesheet">
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link
    rel="stylesheet"
    href="../../../style/admin.css">
  <script src="/js/cadastrarLote.js"> </script>
</head>
  <body>
  <!-- HEADER -->
  <header class="admin-header">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-md-6">
          <div class="d-flex align-items-center">
            <a href="/admin">
              <img
                src="../../../imgs/logo.png"
                alt="Corte Imperial"
                class="admin-logo me-3">
            </a>
            <div>
              <h1 class="admin-brand"> Corte Imperial </h1>
              <p class="admin-subtitle">
                Painel Administrativo
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-6 text-end">
          <span class="user-info">
            <i class="bi bi-person-circle"></i>
            Administrador
          </span>
          <button class="btn-logout">
            <i class="bi bi-box-arrow-right"></i>
            Sair
          </button>
        </div>
      </div>
    </div>
  </header>
  <!-- TÍTULO -->
  <div class="page-title-section">
    <div class="container">
      <h2 class="page-title">
        Alterar Lote
      </h2>
      <p class="page-breadcrumb">
        <a href="/admin">
          <i class="bi bi-house-door"></i>
          Início
        </a>
        <i class="bi bi-chevron-right"></i>
        <a href="/admin/produto/gerenciamento-produto">
          Produtos
        </a>
        <i class="bi bi-chevron-right"></i>
        <a
          href="/admin/produto/gerenciamento-lote/<%= produto.COD_PROD %>">
          Lotes de
          <%= produto.NOME_PROD %>
      </a>
        <i class="bi bi-chevron-right"></i>
        Alterar
      </p>
    </div>
  </div>
  <div class="container">
    <div id="alertContainer"></div>
    <!-- FORMULÁRIO -->
    <div class="form-card">
      <div class="card-header-custom">
        <h3>
          <i class="bi bi-pencil-square"></i>
          Alterar Lote - <%= produto.NOME_PROD %>
        </h3>
      </div>
      <form id="formLote">
        <!-- ID DO LOTE -->
        <input type="hidden" id="idLote" value="<%= lote.COD_LOTE %>">
        <!-- ID DO PRODUTO -->

        <input type="hidden" id="produtoLote" value="<%= lote.COD_PROD %>">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">
              <i class="bi bi-bag"></i>
              Produto
            </label>
            <input type="text" class="form-control" value="<%= produto.NOME_PROD %>" disabled>
          </div>
          <div class="col-md-6 mb-3">
            <label for="numLote" class="form-label">
              <i class="bi bi-upc-scan"></i>
              Número do Lote *
            </label>
            <input type="text" class="form-control" id="numLote" maxlength="50" value="<%= lote.NUM_LOTE %>">
          </div>
        </div>
        <div class="row">
          <div class="col-md-4 mb-3">
            <label for="dataFabLote" class="form-label">
              <i class="bi bi-calendar-event"></i>
              Data de Fabricação
            </label>
            <input type="date" class="form-control" id="dataFabLote" value="<%=lote.DATA_FAB_LOTE%>">
          </div>
          <div class="col-md-4 mb-3">
            <label for="dataVencLote" class="form-label">
              <i class="bi bi-calendar-x"></i>
              Data de Vencimento *
          </label>
            <input type="date" class="form-control" id="dataVencLote" value="<%=lote.DATA_VENC_LOTE%>">
          </div>
          <div class="col-md-4 mb-3">
            <label for="estLote" class="form-label">
              <i class="bi bi-boxes"></i>
              Estoque do Lote *
            </label>
            <input type="number" class="form-control" id="estLote" value="<%= lote.EST_LOTE %>">
          </div>
        </div>
        <div class="row mt-3">
          <div class="col-12 text-end">
            <a href="/admin/produto/gerenciamento-lote/<%= produto.COD_PROD %>" class="btn-clear text-decoration-none">
              <i class="bi bi-arrow-left-circle"></i>
              Cancelar
            </a>
            <button type="button" class="btn-save" id="btnSalvarAlteracao">
              <i class="bi bi-check-circle"></i>
              Salvar Alterações
          </button>
          </div>
        </div>
      </form>
    </div>
  </div>
  <div style="height: 50px;"></div>
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
  </script>
</body>

</html>