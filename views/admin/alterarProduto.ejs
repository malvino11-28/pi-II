<!DOCTYPE html>

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Alterar Produto - Corte Imperial Admin</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
    />

    <link rel="stylesheet" href="/style/admin.css" />
    <script src="/js/cadastrarProduto.js"></script>
  </head>

  <body>
    <!-- HEADER -->

    <header class="admin-header">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-md-6">
            <div class="d-flex align-items-center">
              <a href="/admin">
                <img
                  src="/imgs/logo.png"
                  alt="Corte Imperial"
                  class="admin-logo me-3"
                />
              </a>

              <div>
                <h1 class="admin-brand">Corte Imperial</h1>

                <p class="admin-subtitle">Painel Administrativo</p>
              </div>
            </div>
          </div>

          <div class="col-md-6 text-end">
            <span class="user-info">
              <i class="bi bi-person-circle"></i>

              Administrador
            </span>

            <button class="btn-logout">
              <i class="bi bi-box-arrow-right"></i>

              Sair
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- TÍTULO -->

    <div class="page-title-section">
      <div class="container">
        <h2 class="page-title">Alterar Produto</h2>

        <p class="page-breadcrumb">
          <a href="/admin">
            <i class="bi bi-house-door"></i>

            Início
          </a>

          <i class="bi bi-chevron-right"></i>

          <a href="/admin/produto/gerenciamento-produto"> Produtos </a>

          <i class="bi bi-chevron-right"></i>

          Alterar Produto
        </p>
      </div>
    </div>

    <!-- CONTEÚDO -->

    <input type="hidden" id="idProd" value="<%= produto.COD_PROD %>">

    <div class="container">
      <div class="editar-cliente-card">
        <!-- CABEÇALHO -->

        <div class="editar-cliente-header">
          <div>
            <h3>
              <i class="bi bi-pencil-square"></i>

              Alterar Produto
            </h3>

            <p>Atualize as informações cadastrais do produto.</p>
          </div>

          <a href="/admin/produto/gerenciamento-produto" class="btn-voltar-clientes">
            <i class="bi bi-arrow-left"></i>

            Voltar
          </a>
        </div>

        <!-- TOGGLE -->

        <div class="editar-toggle">
          <button type="button" class="toggle-opcao ativo" id="btnDados">
            <i class="bi bi-box-seam"></i>

            Dados do Produto
          </button>
        </div>

        <form id="formProduto">
          <!-- =====================================

DADOS CADASTRAIS DO PRODUTO

====================================== -->

          <div class="secao-edicao secao-ativa" id="secaoDados">
            <div class="secao-titulo">
              <h4>Dados do Produto</h4>

              <p>Altere as informações do produto.</p>
            </div>



            <!-- LINHA 1: NOME E MARCA -->

            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="nomeProd" class="form-label">
                  <i class="bi bi-person"></i>

                  Nome do Produto *
                </label>

                <input
                  type="text"
                  class="form-control"
                  id="nomeProd"
                  placeholder="Digite o nome do produto"
                  value="<%= produto.NOME_PROD %>"
                />
              </div>

              <div class="col-md-6 mb-3">
                <label for="descRed" class="form-label">
                  <i class="bi bi-person"></i>

                  Descrição Reduzida do Produto *
                </label>

                <input
                  type="text"
                  class="form-control"
                  id="descRed"
                  placeholder="Digite a descrição reduzida do produto que será exibida na página"
                  value="<%= produto.DESC_RED_PROD%>"
                />
              </div>
            </div>

            <!-- LINHA 2: CATEGORIA E DESCRIÇÃO REDUZIDA -->

            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="categoria" class="form-label">
                  <i class="bi bi-telephone"></i>

                  Categoria *
                </label>

                <select class="form-control" id="categoria">
                  <option value="0">-- Selecione uma Categoria --</option>

                  <% for (let i=0;i<categorias.length;i++) { %>

                  <option value="<%=categorias[i].COD_CAT%>" <%= produto.COD_CAT === categorias[i].COD_CAT ? 'selected' : ''%> >
                    <%= categorias[i].NOME_CAT %>
                  </option>

                  <% } %>
                </select>
              </div>

              <div class="col-md-6 mb-3">
                <label for="marca" class="form-label">
                  <i class="bi bi-telephone"></i>

                  Marca *
                </label>

                <select class="form-control" id="marca">
                  <option value="0">-- Selecione uma Marca --</option>

                  <% for (let i=0;i<marcas.length;i++) { %>

                  <option value="<%=marcas[i].COD_MAR%>" <%= produto.COD_MAR === marcas[i].COD_MAR ? 'selected' : ''%>>
                    <%= marcas[i].NOME_MAR %>
                  </option>

                  <% } %>
                </select>
              </div>
            </div>

            <!-- LINHA 3: DESCRIÇÃO DETALHADA -->

            <div class="row">
              <div class="col-12 mb-3">
                <label for="desc" class="form-label">
                  <i class="bi bi-person-vcard"></i>

                  Descrição do Produto *
                </label>

                <textarea
                  class="form-control"
                  id="desc"
                  rows="3"
                  placeholder="Digite a descrição que será exibida na página"
                  
                ><%=produto.DESC_PROD%></textarea>
              </div>
            </div>

            <!-- LINHA 4: UNIDADE DE MEDIDA E VALOR UNITÁRIO -->

            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="uniMedida" class="form-label">
                  <i class="bi bi-telephone"></i>

                  Unidade de Medida *
                </label>

                <select class="form-control" id="uniMedida">
                  <option value="0">-- Selecione uma Medida --</option>
                  <option value="UN" <%= produto.UNI_MEDIDA_PROD === "UN" ? 'selected' : ''%> >UN (Unidade)</option>
                  <option value="KG" <%= produto.UNI_MEDIDA_PROD === "KG" ? 'selected' : ''%> >KG (quilograma)</option>
                  <option value="G" <%= produto.UNI_MEDIDA_PROD === "G" ? 'selected' : ''%> >G (grama)</option>
                  <option value="L" <%= produto.UNI_MEDIDA_PROD === "L" ? 'selected' : ''%> >L (litro)</option>
                  <option value="ML" <%= produto.UNI_MEDIDA_PROD === "ML" ? 'selected' : ''%> >ML (mililitro)</option>
                </select>
              </div>

              <div class="col-md-6 mb-3">
                <label for="valor" class="form-label">
                  <i class="bi bi-lock"></i>

                  Valor Unitário do Produto *
                </label>

                <input
                  type="number"
                  class="form-control"
                  id="valor"
                  placeholder="0,00"
                  value="<%=produto.VALOR_UNI_PROD%>"
                />
              </div>
            </div>
          </div>

          <!-- BOTÕES -->

          <div class="editar-footer">
            <a href="/admin/produto/gerenciamento-produto" class="btn-cancelar-edicao">
              <i class="bi bi-x-circle"></i>

              Cancelar
            </a>

            <button
              type="button"
              class="btn-salvar-edicao"
              id="btnSalvarAlteracao"
            >
              <i class="bi bi-check-circle"></i>

              Salvar Alterações
            </button>
          </div>
        </form>
      </div>
    </div>

    <div style="height: 50px"></div>

    <!-- BOOTSTRAP -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.bundle.min.js"></script>
  </body>
</html>