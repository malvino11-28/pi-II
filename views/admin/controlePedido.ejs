<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Controle de Pedido - Corte Imperial</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/style/admin.css" rel="stylesheet">

    <script src="/js/controlePedido.js"></script>
</head>
<body>
    <header class="admin-header">
        <div class="container d-flex align-items-center">
            <a href="/admin">
                <img src="/imgs/logo.png" alt="Corte Imperial"
                     class="admin-logo me-3">
            </a>

            <div>
                <h1 class="admin-brand">Corte Imperial</h1>
                <p class="admin-subtitle">Painel Administrativo</p>
            </div>
        </div>
    </header>

    <div class="page-title-section">
        <div class="container">
            <h2 class="page-title">
                Controlar pedido #<%= pedido.COD_PED %>
            </h2>

            <a href="/admin/pedidos">Voltar aos pedidos</a>
        </div>
    </div>

    <main class="container mb-5">
        <div class="form-card">
            <div class="card-header-custom">
                <h3>Resumo do pedido</h3>
            </div>

            <p>
                <strong>Cliente:</strong>
                <%= pedido.NOME_CLIENTE %>
            </p>

            <p>
                <strong>E-mail:</strong>
                <%= pedido.EMAIL_PESSOA %>
            </p>

            <p>
                <strong>Telefone:</strong>
                <%= formatarTelefone(pedido.TELEFONE_PESSOA) %>
            </p>

            <p>
                <strong>Data:</strong>
                <%= formatarData(pedido.DATA_PED) %>
            </p>

            <p>
                <strong>Status:</strong>
                <%= pedido.STATUS_PED %>
            </p>

            <p>
                <strong>Pagamento:</strong>
                <%= pedido.FORMA_RECEBIMENTO %>
            </p>

            <p>
                <strong>Total:</strong>
                R$ <%= formatarValor(pedido.TOTAL_PED) %>
            </p>

            <% if (entrega) { %>
                <p>
                    <strong>Atendimento:</strong>
                    Entrega em domicílio
                </p>

                <p>
                    <strong>Endereço:</strong>
                    <%= entrega.RUA_END %>, <%= entrega.NUM_END %> —
                    <%= entrega.BAIRRO_END %>,
                    <%= entrega.CIDADE_END %>/<%= entrega.ESTADO_END %>
                </p>

                <p>
                    <strong>Data da entrega:</strong>
                    <%= formatarData(entrega.DATA_ENT) %>
                </p>

                <p>
                    <strong>Status da entrega:</strong>
                    <%= entrega.STATUS_ENT %>
                </p>
            <% } else { %>
                <p>
                    <strong>Atendimento:</strong>
                    Retirada na loja
                </p>
            <% } %>
        </div>

        <% if (pedido.STATUS_PED === "Pendente" && !entrega) { %>
            <div class="form-card">
                <div class="card-header-custom">
                    <h3>Definir entrega em domicílio</h3>
                </div>

                <p>
                    Para entrega em domicílio, cadastre os dados
                    antes de concluir a preparação.
                </p>

                <label for="enderecoEntrega">
                    Endereço do cliente
                </label>

                <select id="enderecoEntrega" class="form-select mb-3">
                    <option value="">Selecione</option>

                    <% for (let i = 0; i < enderecos.length; i++) { %>
                        <option value="<%= enderecos[i].COD_END %>">
                            <%= enderecos[i].RUA_END %>,
                            <%= enderecos[i].NUM_END %> —
                            <%= enderecos[i].BAIRRO_END %>,
                            <%= enderecos[i].CIDADE_END %>/<%= enderecos[i].ESTADO_END %>
                        </option>
                    <% } %>
                </select>

                <% if (enderecos.length === 0) { %>
                    <p>
                        Cadastre um endereço para este cliente
                        antes de definir a entrega.
                    </p>
                <% } %>

                <label for="dataEntrega">Data da entrega</label>

                <input
                    type="date"
                    id="dataEntrega"
                    class="form-control mb-3"
                >

                <button
                    type="button"
                    id="btnDefinirEntrega"
                    data-id="<%= pedido.COD_PED %>"
                    class="btn btn-primary">
                    Cadastrar entrega
                </button>
            </div>
        <% } %>

        <div class="table-card">
            <div class="table-header">
                <h3 class="table-title">
                    Conferência dos itens por lote
                </h3>
            </div>

            <div class="table-responsive">
                <table class="table clientes-table">
                    <thead>
                        <tr>
                            <th>Separado</th>
                            <th>Produto</th>
                            <th>Lote</th>
                            <th>Quantidade</th>
                            <th>Valor unitário</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% for (let i = 0; i < itens.length; i++) { %>
                            <tr>
                                <td>
                                    <% if (pedido.STATUS_PED === "Pendente") { %>
                                        <input
                                            type="checkbox"
                                            class="form-check-input item-conferido"
                                            data-produto="<%= itens[i].COD_PROD %>"
                                            data-lote="<%= itens[i].COD_LOTE %>"
                                            aria-label="Confirmar separação de <%= itens[i].NOME_PROD %>, lote <%= itens[i].NUM_LOTE %>"
                                        >
                                    <% } else { %>
                                        —
                                    <% } %>
                                </td>

                                <td><%= itens[i].NOME_PROD %></td>
                                <td><%= itens[i].NUM_LOTE %></td>

                                <td>
                                    <%= formatarValor(itens[i].QTD_PROD) %>
                                    <%= itens[i].UNI_MEDIDA_PROD %>
                                </td>

                                <td>
                                    R$ <%= formatarValor(itens[i].VALOR_UNI) %>
                                </td>

                                <td>
                                    R$ <%= formatarValor(
                                        Number(itens[i].QTD_PROD) *
                                        Number(itens[i].VALOR_UNI)
                                    ) %>
                                </td>
                            </tr>
                        <% } %>

                        <% if (itens.length === 0) { %>
                            <tr>
                                <td colspan="6">
                                    Este pedido não possui itens.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="form-card">
            <div class="card-header-custom">
                <h3>Ações do pedido</h3>
            </div>

            <% if (pedido.STATUS_PED === "Pendente") { %>
                <p>
                    Marque cada item somente após separar a quantidade
                    indicada do respectivo lote.
                </p>

                <button
                    type="button"
                    class="btn btn-success btn-status"
                    data-id="<%= pedido.COD_PED %>"
                    data-status="Preparado">
                    Concluir preparação
                </button>

            <% } else if (pedido.STATUS_PED === "Preparado") { %>

                <% if (entrega) { %>
                    <button
                        type="button"
                        class="btn btn-primary btn-status"
                        data-id="<%= pedido.COD_PED %>"
                        data-status="Saiu para entrega">
                        Confirmar saída para entrega
                    </button>
                <% } else { %>
                    <p>
                        A retirada exige que o pagamento total
                        esteja registrado.
                    </p>

                    <button
                        type="button"
                        class="btn btn-success btn-status"
                        data-id="<%= pedido.COD_PED %>"
                        data-status="Retirado">
                        Confirmar retirada
                    </button>
                <% } %>

            <% } %>

            <% if (
                pedido.STATUS_PED === "Pendente" ||
                pedido.STATUS_PED === "Preparado"
            ) { %>
                <button
                    type="button"
                    class="btn btn-danger btn-status"
                    data-id="<%= pedido.COD_PED %>"
                    data-status="Cancelado">
                    Cancelar pedido e devolver estoque
                </button>
            <% } else { %>
                <p>Não há operações disponíveis para este status.</p>
            <% } %>
        </div>
    </main>
</body>
</html>