<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Descarte de Lote - Corte Imperial</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/style/admin.css" rel="stylesheet">

    <script src="/js/descarteLote.js"></script>
</head>
<body>
    <header class="admin-header">
        <div class="container d-flex align-items-center">
            <a href="/admin">
                <img src="/imgs/logo.png" alt="Corte Imperial"
                     class="admin-logo me-3">
            </a>

            <div>
                <h1 class="admin-brand">Corte Imperial</h1>
                <p class="admin-subtitle">Painel Administrativo</p>
            </div>
        </div>
    </header>

    <div class="page-title-section">
        <div class="container">
            <h2 class="page-title">Efetuar descarte</h2>

            <a href="/admin/produto/gerenciamento-lote/<%= produto.COD_PROD %>">
                Voltar aos lotes
            </a>
        </div>
    </div>

    <main class="container mb-5">
        <div class="form-card">
            <div class="card-header-custom">
                <h3>Informações do lote</h3>
            </div>

            <p>
                <strong>Produto:</strong>
                <%= produto.NOME_PROD %>
            </p>

            <p>
                <strong>Lote:</strong>
                <%= lote.NUM_LOTE %>
            </p>

            <p>
                <strong>Vencimento:</strong>
                <%= formatarData(lote.DATA_VENC_LOTE) %>
            </p>

            <p>
                <strong>Estoque atual:</strong>
                <%= formatarValor(lote.EST_LOTE) %>
                <%= produto.UNI_MEDIDA_PROD %>
            </p>
        </div>

        <div class="form-card">
            <div class="card-header-custom">
                <h3>Registrar descarte</h3>
            </div>

            <% if (Number(lote.EST_LOTE) > 0) { %>
                <label for="quantidadeDescarte" class="form-label">
                    Quantidade (<%= produto.UNI_MEDIDA_PROD %>)
                </label>

                <input
                    type="number"
                    id="quantidadeDescarte"
                    class="form-control mb-3"
                    min="0.01"
                    max="<%= Number(lote.EST_LOTE) %>"
                    step="0.01"
                >

                <label for="motivoDescarte" class="form-label">
                    Motivo
                </label>

                <textarea
                    id="motivoDescarte"
                    class="form-control mb-3"
                    rows="3"
                    maxlength="255"></textarea>

                <button
                    type="button"
                    id="btnDescartar"
                    class="btn btn-danger"
                    data-id="<%= lote.COD_LOTE %>">
                    Confirmar descarte
                </button>
            <% } else { %>
                <p>Este lote não possui saldo disponível para descarte.</p>
            <% } %>
        </div>

        <div class="table-card">
            <div class="table-header">
                <h3 class="table-title">Descartes deste lote</h3>
            </div>

            <div class="table-responsive">
                <table class="table clientes-table">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Data</th>
                            <th>Funcionário</th>
                            <th>Quantidade</th>
                            <th>Motivo</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% for (let i = 0; i < descartes.length; i++) { %>
                            <tr>
                                <td>#<%= descartes[i].COD_DESC %></td>

                                <td>
                                    <%= formatarData(descartes[i].DATA_DESC) %>
                                </td>

                                <td>
                                    <%= descartes[i].NOME_FUNCIONARIO %>
                                </td>

                                <td>
                                    <%= formatarValor(descartes[i].QTD_DESC) %>
                                    <%= produto.UNI_MEDIDA_PROD %>
                                </td>

                                <td>
                                    <%= descartes[i].MOTIVO_DESC %>
                                </td>
                            </tr>
                        <% } %>

                        <% if (descartes.length === 0) { %>
                            <tr>
                                <td colspan="5">
                                    Nenhum descarte registrado para este lote.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</body>
</html>