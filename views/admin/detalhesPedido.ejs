<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalhes do Pedido - Corte Imperial</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/style/admin.css" rel="stylesheet">
</head>
<body>
    <header class="admin-header">
        <div class="container d-flex align-items-center">
            <a href="/admin">
                <img src="/imgs/logo.png" alt="Corte Imperial"
                     class="admin-logo me-3">
            </a>

            <div>
                <h1 class="admin-brand">Corte Imperial</h1>
                <p class="admin-subtitle">Painel Administrativo</p>
            </div>
        </div>
    </header>

    <div class="page-title-section">
        <div class="container">
            <h2 class="page-title">Pedido #<%= pedido.COD_PED %></h2>

            <p class="page-breadcrumb">
                <a href="/admin/pedidos">Pedidos</a>
                <i class="bi bi-chevron-right"></i>
                Detalhes
            </p>
        </div>
    </div>

    <main class="container mb-5">
        <div class="form-card">
            <div class="card-header-custom">
                <h3>Resumo do pedido</h3>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <p>
                        <strong>Cliente:</strong>
                        <%= pedido.NOME_CLIENTE %>
                    </p>

                    <p>
                        <strong>E-mail:</strong>
                        <%= pedido.EMAIL_PESSOA %>
                    </p>

                    <p>
                        <strong>Telefone:</strong>
                        <%= formatarTelefone(pedido.TELEFONE_PESSOA) %>
                    </p>
                </div>

                <div class="col-md-6">
                    <p>
                        <strong>Data:</strong>
                        <%= formatarData(pedido.DATA_PED) %>
                    </p>

                    <p>
                        <strong>Status:</strong>
                        <%= pedido.STATUS_PED %>
                    </p>

                    <p>
                        <strong>Forma de recebimento:</strong>
                        <%= pedido.FORMA_RECEBIMENTO %>
                    </p>

                    <p>
                        <strong>Total:</strong>
                        R$ <%= formatarValor(pedido.TOTAL_PED) %>
                    </p>
                </div>
            </div>
        </div>

        <div class="table-card">
            <div class="table-header">
                <h3 class="table-title">Itens do pedido por lote</h3>
            </div>

            <div class="table-responsive">
                <table class="table clientes-table">
                    <thead>
                        <tr>
                            <th>Produto</th>
                            <th>Lote</th>
                            <th>Quantidade</th>
                            <th>Valor unitário</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% for (let i = 0; i < itens.length; i++) {
                            let subtotal = Number(itens[i].QTD_PROD) *
                                           Number(itens[i].VALOR_UNI);
                        %>
                            <tr>
                                <td>
                                    <%= itens[i].NOME_PROD %>
                                </td>

                                <td>
                                    <%= itens[i].NUM_LOTE %>
                                </td>

                                <td>
                                    <%= formatarValor(itens[i].QTD_PROD) %>
                                    <%= itens[i].UNI_MEDIDA_PROD %>
                                </td>

                                <td>
                                    R$ <%= formatarValor(itens[i].VALOR_UNI) %>
                                </td>

                                <td>
                                    R$ <%= formatarValor(subtotal) %>
                                </td>
                            </tr>
                        <% } %>

                        <% if (itens.length === 0) { %>
                            <tr>
                                <td colspan="5" class="sem-clientes">
                                    Este pedido não possui itens registrados.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <a href="/admin/pedidos" class="btn-clear d-inline-block">
            Voltar aos pedidos
        </a>
    </main>
</body>
</html>