<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gerenciamento de Fornecedores - Corte Imperial Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="../../style/admin.css">

    <script src="/js/cadastrarFornecedor.js"></script>
</head>

<body>

    <header class="admin-header">
        <div class="container">
            <div class="row align-items-center">

                <div class="col-md-6">
                    <div class="d-flex align-items-center">

                        <a href="/admin">
                            <img src="../../imgs/logo.png" alt="Corte Imperial" class="admin-logo me-3">
                        </a>

                        <div>
                            <h1 class="admin-brand">Corte Imperial</h1>
                            <p class="admin-subtitle">Painel Administrativo</p>
                        </div>

                    </div>
                </div>

                <div class="col-md-6 text-end">
                    <span class="user-info"><i class="bi bi-person-circle"></i> Administrador</span>
                    <button class="btn-logout"><i class="bi bi-box-arrow-right"></i> Sair</button>
                </div>

            </div>
        </div>
    </header>


    <div class="page-title-section">
        <div class="container">

            <h2 class="page-title">Gerenciamento de Fornecedores</h2>

            <p class="page-breadcrumb">
                <a href="/admin"><i class="bi bi-house-door"></i> Início</a>
                <i class="bi bi-chevron-right"></i>
                Fornecedores
            </p>

        </div>
    </div>


    <div class="container">

        <div class="stats-container">

            <div class="row">

                <div class="col-lg-12 col-md-6 col-12 mb-3">
                    <div class="stat-card">

                        <i class="bi bi-truck stat-icon"></i>

                        <p class="stat-number"><%= fornecedores.length %></p>
                        <p class="stat-label">Total de Fornecedores</p>

                    </div>
                </div>

            </div>

        </div>


        <div class="form-card">

            <div class="card-header-custom">
                <h3><i class="bi bi-truck"></i> Cadastrar Novo Fornecedor</h3>
            </div>


            <form>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="bi bi-building"></i> Razão Social *</label>
                        <input type="text" class="form-control" placeholder="Digite a razão social" id="inputRazao">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label"><i class="bi bi-shop"></i> Nome Fantasia</label>
                        <input type="text" class="form-control" placeholder="Digite o nome fantasia" id="inputNomeFan">
                    </div>

                </div>


                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label class="form-label"><i class="bi bi-card-text"></i> CNPJ *</label>
                        <input type="text" class="form-control" placeholder="00.000.000/0000-00" id="inputCNPJ">
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label"><i class="bi bi-envelope"></i> E-mail *</label>
                        <input type="email" class="form-control" placeholder="contato@empresa.com" id="inputEmail">
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label"><i class="bi bi-telephone"></i> Telefone *</label>
                        <input type="text" class="form-control" placeholder="(00) 00000-0000" id="inputTel">
                    </div>

                </div>


                <div class="row mt-3">

                    <div class="col-12 text-end">

                        <button type="button" class="btn-clear">
                            <i class="bi bi-x-circle"></i> Limpar
                        </button>

                        <button type="button" class="btn-save">
                            <i class="bi bi-check-circle"></i> Salvar Fornecedor
                        </button>

                    </div>

                </div>

            </form>

        </div>


        <div class="table-card">

            <div class="table-header">
                <h3 class="table-title"><i class="bi bi-table"></i> Lista de Fornecedores</h3>
            </div>


            <div class="table-responsive">

                <table class="table clientes-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Razão Social</th>
                            <th>Nome Fantasia</th>
                            <th>CNPJ</th>
                            <th>E-mail</th>
                            <th>Telefone</th>
                            <th>Ações</th>
                        </tr>
                    </thead>


                    <tbody>

                        <% if(fornecedores.length > 0) { %>

                            <% for(let i = 0; i < fornecedores.length; i++) { %>

                                <tr>

                                    <td>#<%= fornecedores[i].COD_FOR %></td>

                                    <td>
                                        <%= fornecedores[i].RAZAO_FOR %>
                                    </td>

                                    <td>
                                        <%= fornecedores[i].NOME_FAN_FOR || "-" %>
                                    </td>

                                    <td>
                                        <%= formatarCNPJ(fornecedores[i].CNPJ_FOR) %>
                                    </td>

                                    <td>
                                        <%= fornecedores[i].EMAIL_FOR %>
                                    </td>

                                    <td>
                                        <%= formatarTelefone(fornecedores[i].TELEFONE_FOR) %>
                                    </td>


                                    <td>

                                        <div class="acoes-cliente">

                                            <a href="/admin/alterar-fornecedor/<%= fornecedores[i].COD_FOR %>" class="btn-acao btn-editar" data-id="<%= fornecedores[i].COD_FOR %>" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <button type="button" class="btn-acao btn-excluir" data-id="<%= fornecedores[i].COD_FOR %>" title="Excluir">
                                                <i class="bi bi-trash"></i>
                                            </button>

                                        </div>

                                    </td>

                                </tr>

                            <% } %>

                        <% } else { %>

                            <tr>

                                <td colspan="7" class="sem-clientes">
                                    <i class="bi bi-truck"></i>
                                    <p>Nenhum fornecedor cadastrado.</p>
                                </td>

                            </tr>

                        <% } %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <div style="height: 50px;"></div>

</body>
</html>