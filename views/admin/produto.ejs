<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Gerenciamento de Fornecedores - Corte Imperial Admin</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
    />

    <link rel="stylesheet" href="../../style/inicio.css" />
    <link rel="stylesheet" href="../../style/admin.css" />
  </head>

  <body>
    <header class="admin-header">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-md-6">
            <div class="d-flex align-items-center">
              <a href="/admin">
                <img
                  src="../../imgs/logo.png"
                  alt="Corte Imperial"
                  class="admin-logo me-3"
                />
              </a>

              <div>
                <h1 class="admin-brand">Corte Imperial</h1>
                <p class="admin-subtitle">Painel Administrativo</p>
              </div>
            </div>
          </div>

          <div class="col-md-6 text-end">
            <span class="user-info">
              <i class="bi bi-person-circle"></i>
              Administrador
            </span>

            <button class="btn-logout">
              <i class="bi bi-box-arrow-right"></i>
              Sair
            </button>
          </div>
        </div>
      </div>
    </header>

    <div class="page-title-section">
      <div class="container">
        <h2 class="page-title">Gerenciamento de Produto</h2>

        <p class="page-breadcrumb">
          <a href="/admin">
            <i class="bi bi-house-door"></i>
            Início
          </a>

          <i class="bi bi-chevron-right"></i>

          Produtos
        </p>
      </div>
      <div class="system-card">
        <div class="container">
          <!-- CARDS ESTATÍSTICAS -->
          <div class="row mb-4">
            <div class="col-lg-4 col-md-6 mb-3">
              <div class="dashboard-stat-card">
                <i class="bi bi-box-seam-fill dashboard-icon"></i>

                <h3>126</h3>

                <p>Produtos</p>
              </div>
            </div>

            <div class="col-lg-4 col-md-6 mb-3">
              <div class="dashboard-stat-card">
                <i class="bi bi-truck dashboard-icon"></i>

                <h3>34</h3>

                <p>Marcas</p>
              </div>
            </div>

            <div class="col-lg-4 col-md-6 mb-3">
              <div class="dashboard-stat-card">
                <i class="bi bi-bar-chart-fill dashboard-icon"></i>

                <h3>18</h3>

                <p>Categorias</p>
              </div>
            </div>
          </div>
          <!-- ÁREAS DO SISTEMA -->
          <div class="system-card">
            <div class="row">
              <!-- Produto -->
              <div class="col-lg-4 col-md-6 mb-4">
                <div class="menu-card">
                  <div class="menu-icon">
                    <i class="bi bi-people-fill"></i>
                  </div>

                  <h4>Produtos</h4>

                  <p>Gerencie os produtos.</p>

                  <a href="/admin/produto/gerenciamento-produto" class="btn-access">
                    <i class="bi bi-arrow-right-circle"></i>
                    Acessar
                  </a>
                </div>
              </div>

              <!-- FORNECEDORES -->
              <div class="col-lg-4 col-md-6 mb-4">
                <div class="menu-card">
                  <div class="menu-icon">
                    <i class="bi bi-truck"></i>
                  </div>

                  <h4>Marcas</h4>

                  <p>Gerencie as marcas</p>

                  <a href="/admin/produto/gerenciamento-marca"" class="btn-access">
                    <i class="bi bi-arrow-right-circle"></i>
                    Acessar
                  </a>
                </div>
              </div>

              <!-- RELATÓRIOS -->
              <div class="col-lg-4 col-md-6 mb-4">
                <div class="menu-card">
                  <div class="menu-icon">
                    <i class="bi bi-bar-chart-fill"></i>
                  </div>

                  <h4>Categorias</h4>

                  <p>Gerencie as categorias.</p>

                  <a href="/admin/produto/gerenciamento-categoria" class="btn-access">
                    <i class="bi bi-arrow-right-circle"></i>
                    Acessar
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div style="height: 50px"></div>
      </div>
    </div>
  </body>
</html>
