<%- include('inicio', {titulo: 'Relatório de descartes'}) %>

<form method="GET" action="/admin/relatorios/descartes" class="filtros">
    <label>
        Data inicial
        <input type="date" name="inicio" value="<%= filtros.inicio %>">
    </label>

    <label>
        Data final
        <input type="date" name="fim" value="<%= filtros.fim %>">
    </label>

    <label>
        Marca
        <select name="marca">
            <option value="">Todas</option>

            <% for (let i = 0; i < marcas.length; i++) { %>
                <option value="<%= marcas[i].COD_MAR %>"
                    <%= filtros.marca == marcas[i].COD_MAR ? 'selected' : '' %>>
                    <%= marcas[i].NOME_MAR %>
                </option>
            <% } %>
        </select>
    </label>

    <label>
        Categoria
        <select name="categoria">
            <option value="">Todas</option>

            <% for (let i = 0; i < categorias.length; i++) { %>
                <option value="<%= categorias[i].COD_CAT %>"
                    <%= filtros.categoria == categorias[i].COD_CAT ? 'selected' : '' %>>
                    <%= categorias[i].NOME_CAT %>
                </option>
            <% } %>
        </select>
    </label>

    <label>
        Produto
        <select name="produto">
            <option value="">Todos</option>

            <% for (let i = 0; i < produtos.length; i++) { %>
                <option value="<%= produtos[i].COD_PROD %>"
                    <%= filtros.produto == produtos[i].COD_PROD ? 'selected' : '' %>>
                    <%= produtos[i].NOME_PROD %>
                </option>
            <% } %>
        </select>
    </label>

    <div class="acoes nao-imprimir">
        <button class="btn btn-primary">Consultar</button>

        <a class="btn btn-secondary"
           href="/admin/relatorios/descartes">Limpar</a>

        <button type="button" class="btn btn-dark"
                onclick="window.print()">Imprimir</button>
    </div>
</form>

<p>Itens de descarte encontrados: <%= lista.length %></p>

<div class="table-responsive">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Código</th>
                <th>Data</th>
                <th>Produto</th>
                <th>Marca</th>
                <th>Categoria</th>
                <th>Lote</th>
                <th>Quantidade</th>
                <th>Motivo</th>
                <th>Funcionário</th>
            </tr>
        </thead>

        <tbody>
            <% for (let i = 0; i < lista.length; i++) { %>
                <tr>
                    <td><%= lista[i].COD_DESC %></td>
                    <td><%= lista[i].DATA %></td>
                    <td><%= lista[i].NOME_PROD %></td>
                    <td><%= lista[i].NOME_MAR %></td>
                    <td><%= lista[i].NOME_CAT %></td>
                    <td><%= lista[i].NUM_LOTE %></td>

                    <td>
                        <%= lista[i].QTD_DESC %>
                        <%= lista[i].UNI_MEDIDA_PROD %>
                    </td>

                    <td><%= lista[i].MOTIVO_DESC %></td>
                    <td><%= lista[i].FUNCIONARIO %></td>
                </tr>
            <% } %>

            <% if (lista.length == 0) { %>
                <tr>
                    <td colspan="9">Nenhum descarte encontrado.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<%- include('fim') %>