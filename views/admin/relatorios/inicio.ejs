<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= titulo %> - Corte Imperial</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="/style/admin.css" rel="stylesheet">

    <style>
        .filtros {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin: 20px 0;
        }

        .filtros label {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .filtros input,
        .filtros select {
            padding: 6px;
            border: 1px solid #bbb;
            border-radius: 5px;
        }

        .filtros .acoes {
            display: flex;
            align-items: end;
            gap: 8px;
        }

        nav {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 20px;
        }

        @media print {
            .nao-imprimir {
                display: none !important;
            }

            .table-responsive {
                overflow: visible;
            }

            body {
                background: white !important;
                font-size: 10px;
            }

            main.container {
                max-width: 100%;
            }

            tr {
                break-inside: avoid;
            }
        }

        @page {
            size: landscape;
            margin: 12mm;
        }
    </style>
</head>

<body>
    <header class="admin-header nao-imprimir">
        <div class="container d-flex align-items-center">
            <a href="/admin">
                <img src="/imgs/logo.png"
                     class="admin-logo me-3"
                     alt="Corte Imperial">
            </a>

            <h1 class="admin-brand">Corte Imperial</h1>
        </div>
    </header>

    <main class="container my-4">
        <nav class="nao-imprimir">
            <a href="/admin">Início</a>
            <a href="/admin/relatorios/descartes">Descartes</a>
            <a href="/admin/relatorios/promocoes">Promoções</a>
            <a href="/admin/relatorios/cancelamentos">Cancelamentos</a>
            <a href="/admin/relatorios/entregas">Entregas</a>
            <a href="/admin/relatorios/pedidos">Pedidos</a>
            <a href="/admin/relatorios/produtos">Produtos</a>
        </nav>

        <h2><%= titulo %></h2>

        <p>
            Corte Imperial — Emitido em
            <%= new Date().toLocaleString("pt-BR") %>
        </p>