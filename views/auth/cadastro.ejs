<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <link rel="apple-touch-icon" sizes="76x76" href="/imgs/logo.png">
  <link rel="icon" type="image/png" href="/imgs/logo.png">
  <title>Corte Imperial</title>

  <!-- Fonts and icons -->
  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet" />
  <link href="/style/nucleo-icons.css" rel="stylesheet" />
  <link href="/style/nucleo-svg.css" rel="stylesheet" />
  <script src="https://kit.fontawesome.com/42d5adcbca.js" crossorigin="anonymous"></script>

  <!-- CSS Files -->
  <link id="pagestyle" href="/style/argon-dashboard.css?v=2.1.0" rel="stylesheet"/>

</head>

<body style="background-color: #EE7B30;">
  <nav class="navbar navbar-expand-lg position-absolute top-0 z-index-3 w-100 shadow-none my-3 navbar-transparent mt-4">
    <div class="container">
      <a href="/"><img src="/imgs/logo.png" alt="logo" style="width: 60px; height: auto;"></a>
      <span class="font-weight-bolder ms-lg-0 ms-3 text-white text-2xl" href="/">
      </span>
      </div>
    </div>
  </nav>
  <!-- End Navbar -->
  <main class="main-content mt-0">
    <div class="page-header align-items-start min-vh-50 pt-5 pb-11" style="background-image: url(/imgs/back-cadastro.png); background-position: top;">
      <span class="mask opacity-6"></span>
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-5 text-center mx-auto">
            <h1 class="text-white mb-2 mt-5">Seja bem-vindo!</h1>
            <p class="text-lead text-white">Crie seu cadastro aqui para se conectar a sua Área de Cliente e continuar com as compras.</p>
          </div>
        </div>
      </div>
    </div>
    <div class="container">
      <div class="row  mt-md-n11 justify-content-center">
        <div class="col-xxl-5 col-xl-4 col-lg-5 col-md-7 mx-auto">
          <div class="card_cadastro z-index-0 shadow pb-3 ">
            <div class="card-header-cadastro text-center pt-4">
              <h5 class="text-white">Cadastre-se aqui</h5>
            </div>
            <div class="card-body px-4 pt-4">
              <form action="/login" method="POST">
                <!-- Nome -->
                <div class="mb-3">
                  <input type="text" class="form-control" id="nomeCli" placeholder="Digite o nome completo">
                </div>

                <!-- CPF -->
                <div class="mb-3">
                  <input type="text" class="form-control" id="cpfCli" placeholder="000.000.000-00" maxlength="14">
                </div>

                <!-- RG -->
                <div class="mb-3">
                  <input type="text" class="form-control" id="rgCli" placeholder="00.000.000-0" maxlength="12">
                </div>

                <!-- Data de Nascimento -->
                <div class="mb-3">
                  <input type="date" class="form-control" id="dataNascCli">
                </div>

                <!-- E-mail -->
                <div class="mb-3">
                  <input type="email" class="form-control" placeholder="Email" aria-label="Email">
                </div>

                <!-- Telefone -->
                <div class="mb-3">
                  <input type="text" class="form-control" id="celCli" placeholder="(00) 00000-0000" maxlength="15">
                </div>

                <!-- Senha -->
                <div class="mb-3">
                  <input type="password" class="form-control" id="senhaCli" placeholder="Digite a senha">
                </div>

                <!-- Confirmação -->
                <div class="mb-3">
                  <input type="password" class="form-control" id="senhaCli" placeholder="Digite a senha novamente">
                </div>

                <div class="form-check form-check-info text-start">
                  <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault" checked>
                  <label class="form-check-label" for="flexCheckDefault">
                    Eu aceito os <a href="javascript:;" style="color: #440a0a;" class="font-weight-bolder">Termos e Condições</a>
                  </label>
                </div>
                <div class="text-center">
                  <button type="submit" class="btn btn-lg btn-primary w-100 mt-4 mb-0">Cadastrar</button>
                </div>
                <p class="text-sm mt-3 mb-0">Já possui uma conta? <a href="/login" style="color: #440a0a;" class="font-weight-bolder">Faça Login</a></p>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <!-- -------- START FOOTER 3 w/ COMPANY DESCRIPTION WITH LINKS & SOCIAL ICONS & COPYRIGHT ------- -->
  <footer class="footer py-5">
    <div class="container">
      <div class="row">
        <div class="col-8 mx-auto text-center mt-1">
          <p class="mb-0 text-secondary text-white">
            Copyright © <script>
              document.write(new Date().getFullYear())
            </script> Criado por Corte Imperial.
          </p>
        </div>
      </div>
    </div>
  </footer>
  <!-- -------- END FOOTER 3 w/ COMPANY DESCRIPTION WITH LINKS & SOCIAL ICONS & COPYRIGHT ------- -->
  <!--   Core JS Files   -->
  <script src="../assets/js/core/popper.min.js"></script>
  <script src="../assets/js/core/bootstrap.min.js"></script>
  <script src="../assets/js/plugins/perfect-scrollbar.min.js"></script>
  <script src="../assets/js/plugins/smooth-scrollbar.min.js"></script>
  <script>
    var win = navigator.platform.indexOf('Win') > -1;
    if (win && document.querySelector('#sidenav-scrollbar')) {
      var options = {
        damping: '0.5'
      }
      Scrollbar.init(document.querySelector('#sidenav-scrollbar'), options);
    }
  </script>
  <!-- Github buttons -->
  <script async defer src="https://buttons.github.io/buttons.js"></script>
  <!-- Control Center for Soft Dashboard: parallax effects, scripts for the example pages etc -->
  <script src="../assets/js/argon-dashboard.min.js?v=2.1.0"></script>
</body>

</html>