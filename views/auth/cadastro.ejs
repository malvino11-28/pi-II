<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <link rel="apple-touch-icon" sizes="76x76" href="/imgs/logo.png">
  <link rel="icon" type="image/png" href="/imgs/logo.png">
  <title>Corte Imperial</title>

  <!-- Fonts and icons -->
  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet" />
  <link href="/style/nucleo-icons.css" rel="stylesheet" />
  <link href="/style/nucleo-svg.css" rel="stylesheet" />
  <script src="https://kit.fontawesome.com/42d5adcbca.js" crossorigin="anonymous"></script>

  <!-- CSS Files -->
  <link id="pagestyle" href="/style/argon-dashboard.css?v=2.1.0" rel="stylesheet"/>
  <script src="/js/cadastro.js"></script>

</head>

<body style="background-color: #EE7B30;">
  <nav class="navbar navbar-expand-lg position-absolute top-0 z-index-3 w-100 shadow-none my-3 navbar-transparent mt-4">
    <div class="container">
      <a href="/"><img src="/imgs/logo.png" alt="logo" style="width: 60px; height: auto;"></a>
      <span class="font-weight-bolder ms-lg-0 ms-3 text-white text-2xl" href="/">
      </span>
      </div>
    </div>
  </nav>
  <!-- End Navbar -->
  <main class="main-content mt-0">
    <div class="page-header align-items-start min-vh-50 pt-5 pb-11" style="background-image: url(/imgs/back-cadastro.png); background-position: top;">
      <span class="mask opacity-6"></span>
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-5 text-center mx-auto">
            <h1 class="text-white mb-2 mt-5">Seja bem-vindo!</h1>
            <p class="text-lead text-white">Crie seu cadastro aqui para se conectar a sua Área de Cliente e continuar com as compras.</p>
          </div>
        </div>
      </div>
    </div>
    <div class="container">
      <div class="row mt-md-n11 justify-content-center">
        <div class="col-12 col-md-10 col-lg-9 col-xl-8 col-xxl-7 mx-auto">
          <div class="card_cadastro z-index-0 shadow pb-3 ">
            <div class="card-header-cadastro text-center pt-4">
              <h5 class="text-white">Cadastre-se aqui</h5>
            </div>
            <div class="card-body px-4 pt-4" style="background-color: #fdf6ec">
              <form action="/cadastrar" method="POST">
                <div class="row">
                  <!-- Nome -->
                  <div class="col-12 col-md-6 mb-3">
                    <label for="nomeCli" class="form-label">Nome completo</label>
                    <input style="background-color: #fdf6ec" type="text" class="form-control" id="nomeCli" placeholder="Digite o nome completo">
                  </div>

                  <!-- CPF -->
                  <div class="col-12 col-md-6 mb-3">
                    <label for="cpfCli" class="form-label">CPF</label>
                    <input style="background-color: #fdf6ec" type="text" class="form-control" id="cpfCli" placeholder="000.000.000-00" maxlength="14">
                  </div>

                  <!-- RG -->
                  <div class="col-12 col-md-6 mb-3">
                    <label for="rgCli" class="form-label">RG</label>
                    <input style="background-color: #fdf6ec" type="text" class="form-control" id="rgCli" placeholder="00.000.000-0" maxlength="12">
                  </div>

                  <!-- Data de Nascimento -->
                  <div class="col-12 col-md-6 mb-3">
                    <label for="dataNascCli" class="form-label">Data de nascimento</label>
                    <input style="background-color: #fdf6ec" type="date" class="form-control" id="dataNascCli">
                  </div>

                  <!-- E-mail -->
                  <div class="col-12 col-md-6 mb-3">
                    <label for="emailCli" class="form-label">E-mail</label>
                    <input style="background-color: #fdf6ec" type="email" class="form-control" id="emailCli" placeholder="Email" aria-label="Email">
                  </div>

                  <!-- Telefone -->
                  <div class="col-12 col-md-6 mb-3">
                    <label for="celCli" class="form-label">Celular</label>
                    <input style="background-color: #fdf6ec" type="text" class="form-control" id="celCli" placeholder="(00) 00000-0000" maxlength="15">
                  </div>

                  <h6 class="col-12 mt-3 mb-3">Endereço</h6>
                  <div class="col-12 col-md-6 mb-3">
                    <label for="cepCli" class="form-label">CEP</label>
                    <input style="background-color: #fdf6ec" type="text" class="form-control" id="cepCli" name="cep" maxlength="9" autocomplete="postal-code" inputmode="numeric" pattern="[0-9]{5}-?[0-9]{3}" required>
                  </div>

                  <div class="col-12 col-md-6 mb-3">
                    <label for="ruaCli" class="form-label">Rua</label>
                    <input style="background-color: #fdf6ec" type="text" class="form-control" id="ruaCli" name="rua" maxlength="255" autocomplete="address-line1" required>
                  </div>

                  <div class="col-12 col-md-6 mb-3">
                    <label for="numeroCli" class="form-label">Número (opcional)</label>
                    <input style="background-color: #fdf6ec" type="text" class="form-control" id="numeroCli" name="numero" maxlength="255">
                  </div>

                  <div class="col-12 col-md-6 mb-3">
                    <label for="bairroCli" class="form-label">Bairro</label>
                    <input style="background-color: #fdf6ec" type="text" class="form-control" id="bairroCli" name="bairro" maxlength="255" autocomplete="address-level3" required>
                  </div>

                  <div class="col-12 col-md-12 mb-3">
                    <label for="compCli" class="form-label">Complemento (opcional)</label>
                    <input style="background-color: #fdf6ec" type="text" class="form-control" id="compCli" name="complemento" maxlength="255">
                  </div>

                  <div class="col-12 col-md-6 mb-3">
                    <label for="cidadeCli" class="form-label">Cidade</label>
                    <input  style="background-color: #fdf6ec" type="text" class="form-control" id="cidadeCli" name="cidade" maxlength="255" autocomplete="address-level2" required>
                  </div>

                  <div class="col-12 col-md-6 mb-3">
                    <label for="ufCli" class="form-label">UF</label>
                    <input  style="background-color: #fdf6ec" type="text" class="form-control" id="ufCli" name="uf" maxlength="2" autocomplete="address-level1" pattern="[A-Za-z]{2}" required>
                  </div>

                  <!-- Senha -->
                  <div class="col-12 col-md-6 mb-3">
                    <label for="senhaCli" class="form-label">Senha</label>
                    <input style="background-color: #fdf6ec" type="password" class="form-control" id="senhaCli" placeholder="Digite a senha">
                  </div>

                  <!-- Confirmação -->
                  <div class="col-12 col-md-6 mb-3">
                    <label for="senhaConfirmacaoCli" class="form-label">Confirmação de senha</label>
                    <input style="background-color: #fdf6ec" type="password" class="form-control" id="senhaConfirmacaoCli" placeholder="Digite a senha novamente">
                  </div>

                </div>

                <div class="form-check form-check-info text-start">
                  <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault" checked>
                  <label class="form-check-label" for="flexCheckDefault">
                    Eu aceito os <a href="javascript:;" style="color: #440a0a;" class="font-weight-bolder">Termos e Condições</a>
                  </label>
                </div>
                <div class="text-center">
                  <button type="button" id="btnCadastrar" class="btn btn-lg btn-primary w-100 mt-4 mb-0">Cadastrar</button>
                </div>
                <p class="text-sm mt-3 mb-0">Já possui uma conta? <a href="/login" style="color: #440a0a;" class="font-weight-bolder">Faça Login</a></p>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <!-- -------- START FOOTER 3 w/ COMPANY DESCRIPTION WITH LINKS & SOCIAL ICONS & COPYRIGHT ------- -->
  <footer class="footer py-5">
    <div class="container">
      <div class="row">
        <div class="col-8 mx-auto text-center mt-1">
          <p class="mb-0 text-secondary text-white">
            Copyright © <script>
              document.write(new Date().getFullYear())
            </script> Criado por Corte Imperial.
          </p>
        </div>
      </div>
    </div>
  </footer>
  <!-- -------- END FOOTER 3 w/ COMPANY DESCRIPTION WITH LINKS & SOCIAL ICONS & COPYRIGHT ------- -->
  <!--   Core JS Files   -->
  <script src="../assets/js/core/popper.min.js"></script>
  <script src="../assets/js/core/bootstrap.min.js"></script>
  <script src="../assets/js/plugins/perfect-scrollbar.min.js"></script>
  <script src="../assets/js/plugins/smooth-scrollbar.min.js"></script>
  <script>
    var win = navigator.platform.indexOf('Win') > -1;
    if (win && document.querySelector('#sidenav-scrollbar')) {
      var options = {
        damping: '0.5'
      }
      Scrollbar.init(document.querySelector('#sidenav-scrollbar'), options);
    }
  </script>
  <!-- Github buttons -->
  <script async defer src="https://buttons.github.io/buttons.js"></script>
  <!-- Control Center for Soft Dashboard: parallax effects, scripts for the example pages etc -->
  <script src="../assets/js/argon-dashboard.min.js?v=2.1.0"></script>
</body>

</html>