
<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <link rel="apple-touch-icon" sizes="76x76" href="/imgs/logo.png">
  <link rel="icon" type="image/png" href="/imgs/logo.png">
  <title>Corte Imperial</title>

  <!-- Fonts and icons -->
  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet" />
  <link href="/style/nucleo-icons.css" rel="stylesheet" />
  <link href="/style/nucleo-svg.css" rel="stylesheet" />
  <script src="https://kit.fontawesome.com/42d5adcbca.js" crossorigin="anonymous"></script>

  <!-- CSS Files -->
  <link id="pagestyle" href="/style/argon-dashboard.css?v=2.1.0" rel="stylesheet"/>

  <script src="/js/login.js"></script>
</head>

<body class="">
  <main class="main-content mt-0">
    <section>
      <div class="page-header min-vh-100">
        <div class="container">
          <div class="row">

            <div class="col-xl-4 col-lg-5 col-md-7 d-flex flex-column mx-lg-0 mx-auto shadow-xl shadow-opacity-100 p-3 bg-body border-radius-lg">
              <div class="card card-plain">

                <div class="card-header pb-0 text-start">

                  <!-- LOGO + TOGGLE -->
                  <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                    <a href="/"><img src="/imgs/logo.png" alt="logo"
                         style="width: 80px; height: auto;"></a>
                    

                    <div class="btn-group" role="group" aria-label="Tipo de login">
                      <button type="button"
                              id="btnCliente"
                              class="btn btn-lg btn-primary mb-0 px-3"
                              aria-pressed="true">
                        Cliente
                      </button>

                      <button type="button"
                              id="btnFuncionario"
                              class="btn btn-lg btn-outline-primary mb-0 px-3"
                              aria-pressed="false">
                        Funcionário
                      </button>
                    </div>

                  </div>

                  <span class="font-weight-bolder text-lg">Login</span>
                  
                  <p id="textoLogin" class="mt-2 mb-0 text-white font-weight-normal">
                    Insira o e-mail e a senha para realizar o login
                  </p>

                </div>

                <div class="card-body">
                  <form action="/login" method="POST">

                    <input type="hidden" id="tipoLogin" name="tipoLogin" value="cliente">

                    <div class="mb-3">
                      <input type="email"
                            id="identificacao"
                            name="identificacao"
                            class="form-control form-control-lg"
                            placeholder="E-mail"
                            aria-label="E-mail">
                    </div>

                    <div class="mb-3">
                      <input type="password"
                            id="senha"
                            name="senha"
                            class="form-control form-control-lg"
                            placeholder="Senha"
                            aria-label="Senha">
                    </div>

                    <div>
                      <span class="text-sm text-white font-weight-normal">
                        Esqueceu a senha?
                        <a class="text-primary text-gradient font-weight-bold" href="">
                          Clique aqui
                        </a>
                      </span>
                    </div>

                    <div class="text-center">
                      <button type="submit" class="btn btn-lg btn-primary w-100 mt-4 mb-0">
                        Entrar
                      </button>
                    </div>

                  </form>
                </div>

                <!-- CADASTRO SOMENTE PARA CLIENTES -->
                <div id="cadastroCliente" class="card-footer text-center pt-0 px-lg-2 px-1">
                  <p class="mb-4 text-sm mx-auto text-white font-weight-normal">
                    Não possui conta?
                    <a href="/cadastrar" class="text-primary text-gradient font-weight-bold">
                      Cadastrar
                    </a>
                  </p>
                </div>
              
                <% if (typeof mensagem != 'undefined' && tipo_usuario == 'funcionario') { %>
                  <div class="alert alert-light mx-xxl-4 text-center" role="alert">
                      
                      <span class="alert-text"><strong><%= mensagem %></strong></span>
                      
                  </div>
                <% } %>
              </div>
            </div>

            <!-- IMAGEM LATERAL ORIGINAL -->
            <div class="col-6 d-lg-flex d-none h-100 my-auto pe-0 position-absolute top-0 end-0 text-center justify-content-center flex-column">
              <div class="position-relative bg-gradient-primary h-100 m-3 px-7 border-radius-lg d-flex flex-column justify-content-center overflow-hidden"
                   style="background-image: url(/imgs/imagemlogologin.png); background-size: cover;">

                <span class="mask bg-gradient-primary opacity-6"></span>

                <h4 class="mt-5 text-white font-weight-bolder position-relative">
                  "Qualidade é a nossa identidade"
                </h4>

                <p class="text-white position-relative">
                  Estamos com vocês nos melhores momentos!
                </p>

              </div>
            </div>

          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Core JS Files -->
  <script src="/js/core/popper.min.js"></script>
  <script src="/js/core/bootstrap.min.js"></script>
  <script src="/js/plugins/perfect-scrollbar.min.js"></script>
  <script src="/js/plugins/smooth-scrollbar.min.js"></script>

  <script>
    var win = navigator.platform.indexOf('Win') > -1;
    if (win && document.querySelector('#sidenav-scrollbar')) {
      var options = {
        damping: '0.5'
      };
      Scrollbar.init(document.querySelector('#sidenav-scrollbar'), options);
    }
  </script>

  <script async defer src="https://buttons.github.io/buttons.js"></script>
  <script src="/js/argon-dashboard.min.js?v=2.1.0"></script>

</body>
</html>
