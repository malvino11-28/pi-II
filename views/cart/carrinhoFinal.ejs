                            <i class="bi bi-truck"></i> Entrega
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="../../pages/main/contato.html">
                            <i class="bi bi-telephone-fill"></i> Contato
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="page-title-section">
        <div class="container">
            <h2 class="page-title">
                <i class="bi bi-cart3"></i> Meu Carrinho
            </h2>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="cart-card">
                    <div class="cart-header">
                        <h3 class="cart-title">
                            <i class="bi bi-bag-check"></i> Itens do Carrinho (<span id="totalItems">0</span>)
                        </h3>
                    </div>
                    <div id="cartItems"> <!-- itens do carrinho vão aparecer dinamicamente aqui --></div>
                </div>
                <a href="/" class="btn-continue">
                    <i class="bi bi-arrow-left"></i> Continuar Comprando
                </a>
            </div>
            <div class="col-lg-4">
                <div class="summary-card">
                    <h3 class="summary-title">Resumo do Pedido</h3>
                    <div class="summary-row">
                        <span>
                            Produtos:
                            <span id="itemCount">0</span>
                        </span>
                    </div>
                    <div class="summary-row">
                        <span>Subtotal:</span>
                        <span id="subtotal">R$ 0,00</span>
                    </div>

                    <div class="summary-row total">
                        <span>Total:</span>
                        <span id="total">R$ 0,00</span>
                    </div>

                    <button
                        type="button"
                        class="btn-checkout"
                        id="btnFinalizarCompra"
                        disabled
                    >
                        <i class="bi bi-check-circle"></i>
                        Finalizar Compra
                    </button>
                </div>
            </div>
        </div>
    </div>

