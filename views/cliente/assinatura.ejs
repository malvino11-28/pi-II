<!-- Conteúdo desta página. O cabeçalho e o menu estão em clienteLayout.ejs. -->
<section id="assinatura" class="secao-cliente">
                    <p class="titulo-pequeno">CLUBE CORTE IMPERIAL</p>
                    <h1 class="h2">Um plano para a sua mesa.</h1>
                    <p class="text-secondary">Escolha como você quer aproveitar os melhores momentos.</p>
                    <div class="convite-clube p-3 rounded my-4">
                        <strong>
                            Seu plano:
                            <span id="plano-atual">
                                <%= planoAssinado ? planoAssinado.NOME_PLANO : 'Sem plano' %>
                            </span>
                        </strong>

                        <p class="small mb-0 mt-1" id="situacao-plano">
                            Status:
                            <%= assinatura ? assinatura.STATUS_ASS : 'Pendente de plano' %>
                        </p>
                    </div>
                    <div class="row g-3">
                        <% for(let i=0; i<planos.length; i++) { %>
                            <div class="col-xl-4">
                                <article class="card h-100"><div class="card-body d-flex flex-column">
                                    <p class="titulo-pequeno">CLUBE CORTE IMPERIAL</p>
                                    <h2 class="h4"><%= planos[i].NOME_PLANO %></h2>
                                    <p class="small text-secondary">Para os bons momentos do dia a dia.</p>
                                    <p class="fs-2 fw-bold text-vinho"><%= planos[i].VALOR_PLANO %><small class="fs-6 fw-normal">/mês</small></p>
                                    <ul class="small ps-3 mb-4">
                                        <li class="mb-2">Promoções exclusivas do clube</li>
                                        <li>Acesso às novidades da loja</li>
                                    </ul>
                                    <button type="button" class="btn btn-vinho mt-auto btn-plano" data-cod-plano="<%= planos[i].COD_PLANO %>" data-nome-plano="<%= planos[i].NOME_PLANO %>" data-valor-plano="<%= planos[i].VALOR_PLANO %>" data-bs-toggle="modal" data-bs-target="#modal-plano">Escolher <%= planos[i].NOME_PLANO %></button>
                                </div></article>
                            </div>
                        <% } %>
                    </div>
                </section>

    <!-- Modal pronto do Bootstrap: usado apenas para a escolha do plano. -->
    <div class="modal fade" id="modal-plano" tabindex="-1" aria-labelledby="titulo-modal" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="titulo-modal">Confirmar plano</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <h3 class="h4" id="nome-plano"></h3>
                <p class="fs-4" id="valor-plano"></p>
                <p class="small text-secondary mb-0">Simulação: nenhum contrato ou pagamento será gerado.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Voltar</button>
                <button type="button" class="btn btn-vinho" id="btn-confirmar-assinatura">Confirmar assinatura</button>
            </div>
        </div></div>
    </div>

