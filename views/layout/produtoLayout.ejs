    <script>
      function altQty(delta) {
        const input = document.getElementById("qty");
        const val = parseInt(input.value) + delta;
        if (val >= 1 && (!input.max || val <= Number(input.max))) input.value = val;
      }
      function trocarImg(thumb, src) {
        document.getElementById("imgPrincipal").src = src;
        document
          .querySelectorAll(".thumbs img")
          .forEach((t) => t.classList.remove("active"));
thumb.classList.add("active");
      }
// ZOOM
      const container = document.getElementById("zoom-container");
      const img = document.getElementById("imgPrincipal");
      const lens = document.getElementById("zoom-lens");
      const result = document.getElementById("zoom-result");
      if (container && img && lens && result) {
    container.addEventListener("mouseenter", () => {
        lens.style.display = "block";
        result.style.display = "block";
      });
      container.addEventListener("mouseleave", () => {
        lens.style.display = "none";
        result.style.display = "none";
      });
      container.addEventListener("mousemove", (e) => {
        const rect = img.getBoundingClientRect();
        const ratio = result.offsetWidth / lens.offsetWidth;
        let x = e.clientX - rect.left - lens.offsetWidth / 2;
        let y = e.clientY - rect.top - lens.offsetHeight / 2;
        x = Math.max(0, Math.min(x, img.offsetWidth - lens.offsetWidth));
        y = Math.max(0, Math.min(y, img.offsetHeight - lens.offsetHeight));
        lens.style.left = x + "px";
        lens.style.top = y + "px";
        result.style.backgroundImage = `url('${img.src}')`;
        result.style.backgroundSize = `${img.offsetWidth * ratio}px ${img.offsetHeight * ratio}px`;
        result.style.backgroundPosition = `-${x * ratio}px -${y * ratio}px`;
      });
      }
    </script>
